# Copy to .env for local development (make dev). .env is not versioned.
ARGOS_ENVIRONMENT=development
ARGOS_DATABASE_URL=postgresql://argos@127.0.0.1:55432/argos
ARGOS_NATS_URL=nats://127.0.0.1:4222
# Host processes and tests connect as argos-dev (deploy/dev/nats/nats.conf); dev-only credentials.
ARGOS_NATS_USER=argos-dev
ARGOS_NATS_PASSWORD=dev-only-nats-host
ARGOS_OPA_TOKEN=dev-only-opa-host
ARGOS_TEMPORAL_ADDRESS=127.0.0.1:7233
ARGOS_LOG_LEVEL=DEBUG
ARGOS_VAULT_ADDR=http://127.0.0.1:8200
# ARGOS_VAULT_TOKEN: a token with the svc-connector-sdk policy; never write it in a versioned file
