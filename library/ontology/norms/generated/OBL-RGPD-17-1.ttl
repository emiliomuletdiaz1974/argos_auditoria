@prefix argos: <https://ns.argos.eu/core#> .
@prefix n: <https://ns.argos.eu/norms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

n:OBL-RGPD-17-1 a argos:Obligation ;
    rdfs:label "Supresión efectiva de los datos"@es ;
    rdfs:comment "Tras una solicitud de supresión sobre un interesado sintético, sus datos dejan de estar en los sistemas de origen dentro del plazo, no solo en el procedimiento escrito."@es ;
    argos:appliesTo n:AC-stored-contact-data,
        n:AC-stored-financial-data,
        n:AC-stored-identifier-data,
        n:AC-stored-personal-data,
        n:AC-stored-special-category-data ;
    argos:derivesFrom n:RGPD-17 ;
    argos:inForceFrom "2018-05-25"^^xsd:date ;
    argos:severity "high" ;
    argos:verifiedBy n:CH-dsr-erasure-effective .

n:CH-dsr-erasure-effective a argos:Challenge ;
    argos:challengeId "dsr-erasure-effective" .

