@prefix argos: <https://ns.argos.eu/core#> .
@prefix n: <https://ns.argos.eu/norms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

n:OBL-AIACT-26-1 a argos:Obligation ;
    rdfs:label "Supervisión humana encomendada a personas competentes"@es ;
    rdfs:comment "El responsable del despliegue ha asignado la supervisión humana de cada sistema de IA de alto riesgo a personas con la competencia, la formación y la autoridad necesarias."@es ;
    argos:appliesTo n:AC-confirmed-ai-system ;
    argos:derivesFrom n:AIACT-26-2 ;
    argos:inForceFrom "2026-08-02"^^xsd:date ;
    argos:severity "medium" ;
    argos:verifiedBy n:CH-doc-ai-human-oversight .

n:CH-doc-ai-human-oversight a argos:Challenge ;
    argos:challengeId "doc-ai-human-oversight" .

