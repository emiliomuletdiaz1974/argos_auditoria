@prefix argos: <https://ns.argos.eu/core#> .
@prefix n: <https://ns.argos.eu/norms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

n:OBL-RGPD-30-2 a argos:Obligation ;
    rdfs:label "Plazos de supresión declarados en el registro"@es ;
    rdfs:comment "Todo tratamiento del registro de actividades declara el plazo previsto para la supresión de las categorías de datos."@es ;
    argos:appliesTo n:AC-stored-contact-data,
        n:AC-stored-financial-data,
        n:AC-stored-identifier-data,
        n:AC-stored-personal-data,
        n:AC-stored-special-category-data ;
    argos:derivesFrom n:RGPD-30-1-f ;
    argos:inForceFrom "2018-05-25"^^xsd:date ;
    argos:severity "medium" ;
    argos:verifiedBy n:CH-coh-treatment-retention-declared .

n:CH-coh-treatment-retention-declared a argos:Challenge ;
    argos:challengeId "coh-treatment-retention-declared" .

