@prefix argos: <https://ns.argos.eu/core#> .
@prefix n: <https://ns.argos.eu/norms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

n:OBL-SELF-3-8-3 a argos:Obligation ;
    rdfs:label "Certificados internos vigentes"@es ;
    rdfs:comment "Ningún servicio tiene un certificado interno que caduque en menos de 7 días, según la última observación del servicio de salud."@es ;
    argos:appliesTo n:AC-argos-appliance ;
    argos:derivesFrom n:SELF-3-8 ;
    argos:inForceFrom "2026-09-24"^^xsd:date ;
    argos:severity "high" ;
    argos:verifiedBy n:CH-self-011 .

n:CH-self-011 a argos:Challenge ;
    argos:challengeId "self-011" .

