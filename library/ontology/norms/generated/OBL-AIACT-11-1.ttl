@prefix argos: <https://ns.argos.eu/core#> .
@prefix n: <https://ns.argos.eu/norms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

n:OBL-AIACT-11-1 a argos:Obligation ;
    rdfs:label "Documentación técnica del sistema de IA de alto riesgo"@es ;
    rdfs:comment "Para un sistema de IA de alto riesgo desarrollado por la organización existe documentación técnica elaborada antes de su puesta en servicio y actualizada."@es ;
    argos:appliesTo n:AC-confirmed-ai-system ;
    argos:derivesFrom n:AIACT-11-1 ;
    argos:inForceFrom "2026-08-02"^^xsd:date ;
    argos:severity "high" ;
    argos:verifiedBy n:CH-doc-ai-technical-documentation .

n:CH-doc-ai-technical-documentation a argos:Challenge ;
    argos:challengeId "doc-ai-technical-documentation" .

