@prefix argos: <https://ns.argos.eu/core#> .
@prefix n: <https://ns.argos.eu/norms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

n:OBL-AIACT-6-1 a argos:Obligation ;
    rdfs:label "Clasificación de riesgo de los sistemas de IA confirmados"@es ;
    rdfs:comment "Todo sistema de IA confirmado tiene asignada una única clase de riesgo del Reglamento (prohibida, alta, limitada o mínima), que determina las obligaciones que le aplican."@es ;
    argos:appliesTo n:AC-confirmed-ai-system ;
    argos:derivesFrom n:AIACT-6 ;
    argos:inForceFrom "2026-08-02"^^xsd:date ;
    argos:severity "high" ;
    argos:verifiedBy n:CH-coh-ai-risk-class-declared .

n:CH-coh-ai-risk-class-declared a argos:Challenge ;
    argos:challengeId "coh-ai-risk-class-declared" .

