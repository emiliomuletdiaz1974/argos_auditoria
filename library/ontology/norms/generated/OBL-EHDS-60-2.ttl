@prefix argos: <https://ns.argos.eu/core#> .
@prefix n: <https://ns.argos.eu/norms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

n:OBL-EHDS-60-2 a argos:Obligation ;
    rdfs:label "Descripción de los conjuntos de datos exacta y actualizada"@es ;
    rdfs:comment "La descripción de los conjuntos de datos comunicada al organismo de acceso coincide con el inventario vivo y se ha revisado al menos una vez en el último año."@es ;
    argos:appliesTo n:AC-stored-health-data ;
    argos:derivesFrom n:EHDS-60-3 ;
    argos:inForceFrom "2029-03-26"^^xsd:date ;
    argos:severity "medium" ;
    argos:verifiedBy n:CH-coh-dataset-description-current .

n:CH-coh-dataset-description-current a argos:Challenge ;
    argos:challengeId "coh-dataset-description-current" .

