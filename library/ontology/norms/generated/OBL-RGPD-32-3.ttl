@prefix argos: <https://ns.argos.eu/core#> .
@prefix n: <https://ns.argos.eu/norms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

n:OBL-RGPD-32-3 a argos:Obligation ;
    rdfs:label "Cifrado en tránsito hacia los sistemas con datos personales"@es ;
    rdfs:comment "Las conexiones a los almacenes con datos personales exigen cifrado en tránsito; una conexión en claro aceptada por el servidor es un hallazgo."@es ;
    argos:appliesTo n:AC-stored-contact-data,
        n:AC-stored-financial-data,
        n:AC-stored-identifier-data,
        n:AC-stored-personal-data,
        n:AC-stored-special-category-data ;
    argos:derivesFrom n:RGPD-32-1-b ;
    argos:inForceFrom "2018-05-25"^^xsd:date ;
    argos:severity "high" ;
    argos:verifiedBy n:CH-sec-encryption-in-transit .

n:CH-sec-encryption-in-transit a argos:Challenge ;
    argos:challengeId "sec-encryption-in-transit" .

