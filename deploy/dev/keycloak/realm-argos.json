{
  "realm": "argos",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "platform_admin",
        "description": "Appliance administration"
      },
      {
        "name": "campaign_manager",
        "description": "Campaign design and execution"
      },
      {
        "name": "dpo_reviewer",
        "description": "Approvals and review (Accountable in RACI)"
      },
      {
        "name": "read_only_auditor",
        "description": "Read-only access to case files"
      }
    ]
  },
  "clients": [
    {
      "clientId": "argos-console",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://127.0.0.1:5173/*",
        "http://127.0.0.1:8000/*"
      ],
      "webOrigins": [
        "http://127.0.0.1:5173",
        "http://127.0.0.1:8000"
      ],
      "protocolMappers": [
        {
          "name": "argos-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "argos-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "argos-api",
      "bearerOnly": true
    },
    {
      "clientId": "argos-tests",
      "description": "DEVELOPMENT ONLY: password grant for integration tests",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "argos-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "argos-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "dpo.test",
      "enabled": true,
      "email": "dpo.test@argos.local",
      "emailVerified": true,
      "firstName": "DPO",
      "lastName": "Synthetic",
      "credentials": [
        {
          "type": "password",
          "value": "test",
          "temporary": false
        }
      ],
      "realmRoles": [
        "dpo_reviewer"
      ]
    },
    {
      "username": "manager.test",
      "enabled": true,
      "email": "manager.test@argos.local",
      "emailVerified": true,
      "firstName": "Campaign",
      "lastName": "Manager",
      "credentials": [
        {
          "type": "password",
          "value": "test",
          "temporary": false
        }
      ],
      "realmRoles": [
        "campaign_manager"
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "customer-oidc",
      "providerId": "oidc",
      "enabled": false,
      "config": {
        "issuer": "SET_AT_DEPLOYMENT",
        "clientId": "SET_AT_DEPLOYMENT",
        "clientSecret": "SET_AT_DEPLOYMENT",
        "defaultScope": "openid profile email groups"
      }
    }
  ]
}
