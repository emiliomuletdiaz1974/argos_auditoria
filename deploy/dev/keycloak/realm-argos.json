{
  "realm": "argos",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "platform_admin",
        "description": "Appliance administration",
        "composite": true,
        "composites": {
          "realm": [
            "mfa_required"
          ]
        }
      },
      {
        "name": "campaign_manager",
        "description": "Campaign design and execution"
      },
      {
        "name": "dpo_reviewer",
        "description": "Approvals and review (Accountable in RACI)",
        "composite": true,
        "composites": {
          "realm": [
            "mfa_required"
          ]
        }
      },
      {
        "name": "read_only_auditor",
        "description": "Read-only access to case files"
      },
      {
        "name": "mfa_required",
        "description": "Signs in with a second factor (TOTP): part of the roles that decide (F09-07)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "argos-console",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "http://127.0.0.1:5173/*",
        "http://127.0.0.1:8000/*"
      ],
      "webOrigins": [
        "http://127.0.0.1:5173",
        "http://127.0.0.1:8000"
      ],
      "protocolMappers": [
        {
          "name": "argos-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "argos-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "argos-api",
      "bearerOnly": true
    },
    {
      "clientId": "argos-tests",
      "description": "DEVELOPMENT ONLY: password grant for integration tests",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "argos-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "argos-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "argos-other",
      "description": "DEVELOPMENT ONLY: tokens for another audience (access battery, F09-15)",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "argos-expiring",
      "description": "DEVELOPMENT ONLY: tokens that expire in 5 s (access battery, F09-15)",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "argos-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "argos-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "access.token.lifespan": "5"
      }
    }
  ],
