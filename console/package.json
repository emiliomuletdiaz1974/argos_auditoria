{
  "name": "argos-console",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "ARGOS console: React, Vite and strict TypeScript, served by the v1 API (ADR-0013)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "api:types": "openapi-typescript ../services/api/openapi.json -o src/api/schema.d.ts",
    "api:check": "node scripts/check-api-types.mjs",
    "e2e": "playwright test",
    "e2e:setup": "playwright install chromium"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "swr": "^2.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.6.1",
    "stylelint": "^16.19.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.2"
  }
}
